APP_NAME=Trendly AI API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
# Generate a unique random value for every deployed environment.
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
# Generate a Fernet key if encrypted integrations are enabled.
ENCRYPTION_KEY=generate-a-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Local development only. Production is blocked until managed DB support is implemented.
SQLITE_PATH=./trendly_ai.db
