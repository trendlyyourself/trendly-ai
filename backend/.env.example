APP_NAME=Trendly AI
APP_ENV=development
FRONTEND_URL=http://127.0.0.1:5173
# Generate a unique random value for every deployed environment.
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
# Keep local SQLite data outside version control. Production persistence requires a managed database.
SQLITE_PATH=./trendly_ai.db
ACCESS_TOKEN_EXPIRE_MINUTES=10080
